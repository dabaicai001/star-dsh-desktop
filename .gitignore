# ============================================
#  依赖与构建产物
# ============================================

# Rust / Tauri
target/
**/*.rs.bk
Cargo.lock.bak
# 保留根 Cargo.lock,Tauri workspace 模式需要
!**/Cargo.lock

# Node / Vue
node_modules/
.pnpm-store/
dist/
dist-embed/
dist-starhub-react/
dist-ssr/
.vite/
*.local
.npm/
.yarn/
.pnp.*

# Go Sidecar
sidecar/bin/
sidecar/dist/
*.exe
*.test
*.out

# 编辑器 / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# 环境与密钥
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
secrets/
config/local.*

# 日志与临时
*.log
logs/
tmp/
temp/
.cache/
.parcel-cache/
.turbo/

# 测试与覆盖率
coverage/
*.lcov
.nyc_output/

# 系统文件
.directory
.Trash-*

# Tauri 特定
src-tauri/target/
src-tauri/target-*/
src-tauri/gen/
# dsh runtime 入包产物(由 npm run package:dsh-runtime 生成)
src-tauri/binaries/

# 跨平台
# Windows
$RECYCLE.BIN/
desktop.ini
ehthumbs.db
# macOS
.AppleDouble
.LSOverride
/Icon?
# Linux
*~
.fuse_hidden*

# Docker
.dockerignore-target/

# 数据库本地数据(开发用)
*.db
*.db-journal
*.sqlite
*.sqlite-journal
data/local/

# 用户资产与配置(不要提交)
assets.local.json
config.local.toml

# Logo 候选与临时备份(手动迭代用,不入仓;注意 src-tauri/icons/ 是 Tauri 必需资源,不能误伤)
/icons/_candidates/
/icons/_original/

# Python 虚拟环境(e2e 测试服务器依赖)
test-sftp/.venv/
test-sftp/__pycache__/
# 测试 SSH/SFTP 服务器的持久 host key(本地生成的测试私钥,不入库)
test-sftp/host_key.pem
# exec_server.py 的 SFTP 根目录(服务器首启自动创建并写入 hello.txt)
test-sftp/sftp-root/
