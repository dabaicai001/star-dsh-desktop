{
  "name": "@deepseek-ai/dsh-starhub-memory-sink",
  "description": "StarHub memory sink (2026-08-22, v0.92.0): a turn-stopping plugin that auto-distills durable facts from the just-completed turn into long-term memories (folder:<cwd> or global). Replaces the legacy Vue aiMemoryReviewGates pipeline that was dropped during the v0.79 AI kernel swap. Gates on starhub-memory-context.autoReview (default false since v0.92.0); writes go through starhub/memory.write (sdk-transport) → Rust ai_memory_add. StarHub-local package, not upstream.",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/types/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "@deepseek-ai/dsh-starhub-memory-context": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-sdk-protocol": "workspace:^",
    "@deepseek-ai/dsh-settings": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-sdk-protocol": "workspace:^",
    "@deepseek-ai/dsh-settings": "workspace:^"
  }
}
