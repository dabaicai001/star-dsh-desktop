{
  "name": "dsh-profile-starhub-web",
  "private": true,
  "description": "StarHub web profile manifest template: the boot script copies this file to $DSH_HOME/profiles/web/package.json (see boot.mjs)",
  "dependencies": {
    "@deepseek-ai/dsh-starhub-client-nav": "workspace:*",
    "@deepseek-ai/dsh-starhub-host-static": "workspace:*",
    "@deepseek-ai/dsh-starhub-tool-context": "workspace:*",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "workspace:*",
    "@deepseek-ai/dsh-starhub-tools": "workspace:*",
    "@deepseek-ai/dsh-starhub-approval-bridge": "workspace:*",
    "@deepseek-ai/dsh-starhub-session-registry": "workspace:*",
    "@deepseek-ai/dsh-starhub-domain-events": "workspace:*",
    "@deepseek-ai/dsh-starhub-live-context": "workspace:*",
    "@deepseek-ai/dsh-starhub-memory-context": "workspace:*",
    "@deepseek-ai/dsh-starhub-memory-sink": "workspace:*",
    "@deepseek-ai/dsh-starhub-commit-message": "workspace:*"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app"
      ]
    }
  }
}
